API_BASE_URL=https://api.dpms.com/api
ENVIRONMENT=production

# ─── Reverb (real-time) ─────────────────────────────────────
# wss is required: a ws:// socket opened from an https:// page is blocked as
# mixed content. Never put REVERB_APP_SECRET here.
REVERB_APP_KEY=
REVERB_HOST=ws.dpms.com
REVERB_PORT=443
REVERB_SCHEME=https
