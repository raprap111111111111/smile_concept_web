{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🔴 Kill Port 3000",
            "type": "shell",
            "command": "lsof -ti :3000 | xargs kill -9 2>/dev/null; exit 0",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "close": true,
                "showReuseMessage": false
            }
        },
        {
            "label": "🔴 Kill All Flutter/Dart",
            "type": "shell",
            "command": "pkill -9 -f dart 2>/dev/null; pkill -9 -f flutter 2>/dev/null; echo '✅ Killed'; exit 0",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "🧹 Flutter Clean + Get",
            "type": "shell",
            "command": "flutter clean && flutter pub get",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
